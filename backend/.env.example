# Samvada Studio Backend Proxy - Environment Configuration
# Copy this file to .env for local development

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (optional - adds to default whitelist)
# FRONTEND_URL=https://your-custom-domain.com

# Note: This proxy does NOT store API keys
# Users provide keys via the frontend UI (BYOK - Bring Your Own Keys)
